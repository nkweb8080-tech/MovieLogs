// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

//Prismaのスキーマ
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//ユーザテーブル
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deleteFlg    Boolean  @default(false)

  movieRecords MovieRecord[]
}

model Movie {
  id            String        @id @default(cuid())
  tmdbMovieId   Int           @unique
  title         String
  originalTitle String?
  posterPath    String?
  releaseDate   DateTime?
  genreNames    String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deleteFlg    Boolean  @default(false)
}

model MovieRecord {
  id              String   @id @default(cuid())
  userId          String
  movieId         String
  watchedAt       DateTime
  rating          Int
  review          String?
  isFavorite      Boolean  @default(false)
  isRewatch       Boolean  @default(false)
  containsSpoiler Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deleteFlg    Boolean  @default(false)

  user User @relation( fields: [userId],references: [email],onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([userId, watchedAt])
}

enum ViewingMethod {
  CINEMA
  STREAMING
  RENTAL
  TELEVISION
  BLURAY
  DVD
  OTHER
}